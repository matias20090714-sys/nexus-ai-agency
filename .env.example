# ==========================================
# NEXUS AI AGENCY - ENVIRONMENT CONFIGURATION
# ==========================================

# Clave API Gratuita de Google Gemini (Obtén la tuya en https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Modelo preferido (gemini-1.5-flash es ultra rápido y 100% gratuito)
AI_MODEL=gemini-1.5-flash

# Base de datos Neon PostgreSQL (Opcional para almacenamiento en la nube)
# DATABASE_URL=postgresql://neondb_owner:...@ep-....us-east-2.aws.neon.tech/neondb?sslmode=require

# Puerto del servidor
PORT=5180
